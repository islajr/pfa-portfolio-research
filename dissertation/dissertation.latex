% ── Additional academic packages ───────────────────────────────────────────────
\usepackage{graphicx}
\usepackage{fancyhdr}
\usepackage{setspace}
\usepackage{titlesec}
\usepackage{caption}
\usepackage{microtype}
\usepackage{parskip}
\usepackage{etoolbox}
\usepackage{ragged2e}

% ── Unicode Character Fallbacks ────────────────────────────────────────────────
\catcode`\★=\active
\def★{\ensuremath{\star}}
\catcode`\○=\active
\def○{\ensuremath{\circ}}

% ── Fonts (Traditional Computer Modern / Latin Modern) ────────────────────────
\usepackage{lmodern}

% ── Hyperlinks ─────────────────────────────────────────────────────────────────
\hypersetup{
  colorlinks=true,
  linkcolor=black,
  urlcolor=black,
  citecolor=black,
  pdfborder={0 0 0},
  pdftitle={Heuristics in Property Portfolio Selection Decisions of Nigerian Pension Funds},
  pdfauthor={Akinmokun Isaac Oluwaseun},
  pdfsubject={Heuristics in Property Portfolio Selection of Nigerian Pension Funds}
}

% ── Spacing ────────────────────────────────────────────────────────────────────
\doublespacing
\setlength{\parindent}{0pt}
\setlength{\parskip}{8pt plus 2pt minus 2pt}

% ── Image default sizing ────────────────────────────────────────────────────────
\setkeys{Gin}{width=\linewidth,keepaspectratio}

% ── Caption style ──────────────────────────────────────────────────────────────
\captionsetup{
  font=small,
  labelfont=bf,
  justification=justified,
  singlelinecheck=false,
  skip=4pt,
  labelformat=empty
}

% ── Chapter heading ────────────────────────────────────────────────────────────
\titleformat{\chapter}[block]
  {\normalfont\large\bfseries\centering}
  {}
  {0pt}
  {\MakeUppercase}
\titlespacing*{\chapter}{0pt}{0pt}{18pt}

\let\origchapter\chapter
\RenewDocumentCommand{\chapter}{s o m}{%
  \IfBooleanTF{#1}{%
    \origchapter*{#3}%
  }{%
    \IfNoValueTF{#2}{%
      \origchapter{#3}%
    }{%
      \origchapter[#2]{#3}%
    }%
  }%
  \ifstrequal{#3}{HEURISTICS IN PROPERTY PORTFOLIO SELECTION DECISIONS OF NIGERIAN PENSION FUNDS}{\thispagestyle{empty}\centering}{}%
  \ifstrequal{#3}{Abstract}{\singlespacing\small\thispagestyle{plain}\justifying}{}%
  \ifstrequal{#3}{CHAPTER ONE}{\doublespacing\normalsize\setcounter{page}{1}\justifying}{}%
}

% ── Section heading ────────────────────────────────────────────────────────────
\titleformat{\section}
  {\normalfont\normalsize\bfseries}
  {}
  {0pt}
  {}
\titlespacing*{\section}{0pt}{14pt plus 2pt}{6pt}

% ── Subsection heading ─────────────────────────────────────────────────────────
\titleformat{\subsection}
  {\normalfont\normalsize\bfseries}
  {}
  {0pt}
  {}
\titlespacing*{\subsection}{0pt}{12pt}{4pt}

% ── Subsubsection heading ──────────────────────────────────────────────────────
\titleformat{\subsubsection}
  {\normalfont\normalsize\itshape\bfseries}
  {}
  {0pt}
  {}
\titlespacing*{\subsubsection}{0pt}{10pt}{3pt}

% ── Table spacing override ─────────────────────────────────────────────────────
\renewcommand{\arraystretch}{1.3}
\AtBeginEnvironment{longtable}{\singlespacing\small}
\AtBeginEnvironment{tabular}{\singlespacing\small}

% ── Header / footer ────────────────────────────────────────────────────────────
\pagestyle{fancy}
\fancyhf{}
\fancyhead[R]{\footnotesize\itshape Heuristics in Property Portfolio Selection of Nigerian Pension Funds}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[C]{\thepage}%
  \renewcommand{\headrulewidth}{0pt}%
}

\begin{document}
\thispagestyle{empty}

$body$

